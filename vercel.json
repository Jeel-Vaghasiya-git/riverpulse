{
  "rewrites": [
    {
      "source": "/gangapulse-api/:path*",
      "destination": "/api/gangapulse.js?path=:path*"
    },
    {
      "source": "/datagov-api/:path*",
      "destination": "/api/datagov.js?path=:path*"
    },
    {
      "source": "/cpcb-api/:path*",
      "destination": "/api/cpcb.js?path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
