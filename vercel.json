{
  "rewrites": {
    "beforeFiles": [
      {
        "source": "/gangapulse-api/:path*",
        "destination": "/api/gangapulse?path=:path*"
      },
      {
        "source": "/datagov-api/:path*",
        "destination": "/api/datagov?path=:path*"
      },
      {
        "source": "/cpcb-api/:path*",
        "destination": "/api/cpcb?path=:path*"
      }
    ],
    "fallback": [
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ]
  }
}
