{
  "rewrites": [
    {
      "source": "/gangapulse-api/:path*",
      "destination": "https://www.gangapulse.in/:path*"
    },
    {
      "source": "/datagov-api/:path*",
      "destination": "https://api.data.gov.in/:path*"
    },
    {
      "source": "/cpcb-api/:path*",
      "destination": "https://rtwqmsdb1.cpcb.gov.in/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
